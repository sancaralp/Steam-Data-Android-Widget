<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Steam Data Widget"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Daily and total wishlists, live players, 24h peak and recent revenue for your Steam games, straight from the Steamworks APIs."
            android:textColor="@color/dim"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_bg"
            android:padding="10dp"
            android:textColor="@color/body"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/hint_add_widget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Long-press your home screen, choose Widgets, and add “Steam Data Widget”, or use the button below."
            android:textColor="@color/dim"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_pin"
            style="@style/Widget.AppCompat.Button.Borderless.Colored"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Add widget to home screen"
            android:textAllCaps="false" />

        <TextView
            style="@style/SettingsLabel"
            android:text="Financial API key" />

        <EditText
            android:id="@+id/fin_key"
            style="@style/SettingsInput"
            android:hint="Wishlists and revenue"
            android:inputType="textNoSuggestions|textVisiblePassword" />

        <TextView
            style="@style/SettingsLabel"
            android:text="Publisher Web API key" />

        <EditText
            android:id="@+id/pub_key"
            style="@style/SettingsInput"
            android:hint="Finds your games and demos, players of unreleased apps"
            android:inputType="textNoSuggestions|textVisiblePassword" />

        <TextView
            android:id="@+id/help_link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:padding="4dp"
            android:text="How to create the keys in Steamworks ↗"
            android:textColor="@color/blue"
            android:textSize="13sp" />

        <TextView
            style="@style/SettingsLabel"
            android:text="Exclude App IDs (optional, comma separated)" />

        <EditText
            android:id="@+id/exclude"
            style="@style/SettingsInput"
            android:hint="e.g. 1234560, 1234570"
            android:inputType="text" />

        <TextView
            style="@style/SettingsLabel"
            android:text="Manual games (optional, JSON)" />

        <EditText
            android:id="@+id/games_json"
            style="@style/SettingsInput"
            android:fontFamily="monospace"
            android:gravity="top"
            android:hint="[{&quot;name&quot;: &quot;My Game&quot;, &quot;appid&quot;: 1234560, &quot;demo_appid&quot;: 1234570}]"
            android:inputType="textMultiLine|textNoSuggestions"
            android:minLines="2"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/SettingsLabel"
                    android:text="Refresh every (minutes)" />

                <EditText
                    android:id="@+id/interval"
                    style="@style/SettingsInput"
                    android:inputType="number" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/SettingsLabel"
                    android:text="Day starts at (hour)" />

                <EditText
                    android:id="@+id/day_start"
                    style="@style/SettingsInput"
                    android:inputType="number" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Steam’s reporting day starts at midnight Pacific time. 10 is right for Türkiye (UTC+3) in summer; use 11 from November to March, or your own local equivalent."
            android:textColor="@color/dim"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_save"
            style="@style/Widget.AppCompat.Button.Colored"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Save"
            android:textAllCaps="false" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_refresh"
                style="@style/Widget.AppCompat.Button.Borderless.Colored"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Refresh now"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn_clear"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Clear cached data"
                android:textAllCaps="false"
                android:textColor="@color/dim" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="The keys stay on this device and are only ever sent to Steam (partner.steam-api.com, api.steampowered.com, store.steampowered.com). The Financial key can read all sales data for your partner account, so consider restricting it to your IP in Steamworks.\n\nThe first refresh downloads the full wishlist history once (a game with ~1,400 days takes about 6–7 minutes). Later refreshes take a few seconds."
            android:textColor="@color/dim"
            android:textSize="12sp" />

        <TextView
            style="@style/SettingsLabel"
            android:text="Recent errors" />

        <TextView
            android:id="@+id/log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:fontFamily="monospace"
            android:padding="10dp"
            android:textColor="@color/dim"
            android:textIsSelectable="true"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
