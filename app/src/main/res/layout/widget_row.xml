                    android:paddingEnd="2dp"
                    android:text="SteamDB"
                    android:textColor="@color/dim"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/line3"
            android:layout_width="match_parent"
            android:layout_height="26dp"
